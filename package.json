{
  "name": "pixiv-fanbox-downloader",
  "version": "5.0.0",
  "description": "Pixiv Fanbox Downloader",
  "repository": "https://github.com/xuejianxianzun/PixivFanboxDownloader",
  "author": "xuejianxianzun",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "less": "lessc -x ./src/style/style.less ./dist/style/style.css",
    "ts": "node ./build-ntfy-config.js && webpack --config ./webpack.conf.js",
    "fmt": "prettier -c --write \"src/ts/**\" && prettier -c --write \"src/style/**\"",
    "pre-build": "npm run ts && npm run less && npm run fmt",
    "build": "npm run pre-build && node ./pack.js",
    "typecheck": "tsc --noEmit",
    "test": "tsc src/ts/queue/DurableQueue.ts src/ts/queue/Ownership.ts src/ts/queue/LocalEagle.ts src/ts/queue/Acquire.ts --rootDir src/ts --module commonjs --moduleResolution node --target es2022 --lib dom,esnext --types chrome --skipLibCheck --outDir .test-build && node tests/queue.cjs && node tests/verifier.cjs && node tests/reconcile.cjs && node tests/acquire.cjs",
    "test:headless": "node tests/headless.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "archiver": "^7.0.1",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "fake-indexeddb": "6.2.4",
    "less": "4.2.2",
    "prettier": "3.3.3",
    "recursive-copy": "^2.0.14",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0"
  }
}
